{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2022",
    "module": "commonjs",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "declaration": false,
    "strict": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["modules/*"],
      "@src/*": ["src/*"],
    },
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["src", "modules/lib/node/child-process/cp-script/*.ts"]
}

