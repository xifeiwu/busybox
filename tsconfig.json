{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2022",
    "module": "commonjs",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "declaration": false,
    "strict": false,
    "sourceMap": false,
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@modules/*": ["modules/*"],
      "@src/*": ["src/*"]
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["src", "modules/lib/node/utils/cp-script/**/*.ts", "modules/lib/node/utils/run-script-in-cp/**/*.ts"],
  "exclude": ["node_modules/**/*"]
}
