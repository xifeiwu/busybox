{
  "compilerOptions": {
    "outDir": ".",
    "target": "ES2022",
    "module": "commonjs",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "strict": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["modules/*"],
      "@src/*": ["src/*"],
    },
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["bin", "src"],
  "exclude": ["modules/*"]
}

