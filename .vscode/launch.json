{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Run TS Export",
      // "request": "launch",
      // "runtimeExecutable": "runtsExport",
      "runtimeExecutable": "runTsExport",
      // "program": "runOntsNode",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}",
      // "protocol": "inspector",
      // "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ts-node",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "ts-node",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}",
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run On TsNode",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "runOntsNode",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}",
    },
    {
      "type": "node",
      "name": "Run JS Export",
      // "request": "launch",
      // "runtimeExecutable": "runtsExport",
      "runtimeExecutable": "runJsExport",
      // "program": "runOntsNode",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}",
      // "protocol": "inspector",
      // "internalConsoleOptions": "openOnSessionStart"
    },
  ]
}