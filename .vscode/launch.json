{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "runNodeExport",
      // "request": "launch",
      "runtimeExecutable": "runNodeExport",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "runNodeScript",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "runNodeScript",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ts-node",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "ts-node",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
    }
  ]
}
