{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Run TS Export",
      // "request": "launch",
      // "runtimeExecutable": "runtsExport",
      "runtimeExecutable": "runTsExport",
      // "program": "runOntsNode",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
      // "protocol": "inspector",
      // "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ts-node",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "ts-node",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run On TsNode",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "runTsScript",
      "args": ["${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}"
    }
  ]
}
